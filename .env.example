SECRET_KEY=YOUR_SECRET_KEY

# ======================= Email SMTP =========================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=your_email_account

# ========================= Redis =========================
REDIS_HOST=your_redis
REDIS_PORT=your_redis_port

# ========================= POSTGRESQL =========================
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=your_database_port

# ========================= Celery SetUp =========================
CELERY_BROKER_URL=your_celery_url
CELERY_RESULT_BACKEND=your_celery_backend
CELERY_TASK_SERIALIZER=your_celery_task
CELERY_RESULT_SERIALIZER=your_celery_result
CELERY_TASK_TRACK_STARTED=your_celery_task_start
CELERY_TIMEZONE=your_celery_timezone
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

